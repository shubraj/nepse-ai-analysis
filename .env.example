# Copy to .env. Do not commit.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_RETRIES=5
RETRY_DELAY=5.0
API_TIMEOUT=30

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nepseanalysis
CORS_ORIGINS=http://localhost:8212,http://127.0.0.1:8212,http://localhost:5173,http://127.0.0.1:5173
